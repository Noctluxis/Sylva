# Publish the application and its build inputs.
/*
!/.gitignore
!/.gitattributes
!/Cargo.toml
!/Cargo.lock
!/build.rs
!/LICENSE
!/README.md
!/THIRD_PARTY.md
!/.cargo/
!/.cargo/config.toml
!/src/
!/native/
/native/*_probe.cpp
!/bindings/
!/assets/
/assets/*
!/assets/branding/
!/assets/icons/
/assets/icons/*.md
!/assets/key-sounds/
/assets/key-sounds/*
!/assets/key-sounds/E-wood.pcm
!/data/
/data/*
!/data/msime-dictionary-manifest.json
!/models/
/models/*.md
!/packaging/
!/scripts/
/scripts/*
!/scripts/fetch-assets.ps1
!/scripts/generate-app-icon.cjs
!/scripts/make-bindings.py
!/scripts/package.py
!/scripts/verify-package.py
!/vendor/
/vendor/*
!/vendor/OPENVR-LICENSE.txt
!/vendor/openvr.h
!/vendor/openvr_api.dll
!/vendor/openvr_api.lib
